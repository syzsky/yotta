# Public defaults for task build; process environment overrides these addresses.
YOTTA_ACCOUNT_URL=https://account.yuelili.com/
YOTTA_REGISTRY_URL=https://yotta.yuelili.com/api/registry
YOTTA_HUB_URL=https://yotta.yuelili.com/api/hub
YOTTA_REGISTRY_ALLOW_INSECURE_HTTP=false
YOTTA_HUB_ALLOW_INSECURE_HTTP=false
YOTTA_OIDC_AUTHORIZATION_ENDPOINT=https://account.yuelili.com/oauth2/authorize
YOTTA_OIDC_TOKEN_ENDPOINT=https://account.yuelili.com/oauth2/token
YOTTA_OIDC_USERINFO_ENDPOINT=https://account.yuelili.com/oauth2/userinfo
YOTTA_OIDC_CLIENT_ID=yotta-desktop-online-test
YOTTA_OIDC_CALLBACK_ADDRESS=127.0.0.1:43822
YOTTA_REGISTRY_AUDIENCE=
