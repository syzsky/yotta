# Public service endpoints. Copy to .env.local for task build/task dev.
# task build embeds these defaults; process environment variables override them at launch.
# Local Registry and Identity must be running for these development values.
YOTTA_REGISTRY_URL=http://127.0.0.1:8090
YOTTA_ACCOUNT_URL=http://127.0.0.1:3011/
YOTTA_HUB_URL=http://127.0.0.1:8094
YOTTA_HUB_ALLOW_INSECURE_HTTP=true
YOTTA_REGISTRY_ALLOW_INSECURE_HTTP=true
YOTTA_OIDC_AUTHORIZATION_ENDPOINT=http://127.0.0.1:3011/oauth2/authorize
YOTTA_OIDC_TOKEN_ENDPOINT=http://127.0.0.1:8091/oauth2/token
YOTTA_OIDC_USERINFO_ENDPOINT=http://127.0.0.1:8091/oauth2/userinfo
YOTTA_OIDC_CLIENT_ID=yotta-desktop
YOTTA_OIDC_CALLBACK_ADDRESS=127.0.0.1:43821
YOTTA_REGISTRY_AUDIENCE=urn:yotta:registry
